#include <dt-bindings/zmk/matrix_transform.h>

#include <physical_layouts.dtsi>

&uicr {
    nfct-pins-as-gpios;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layouts = &physical_layout_0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)      RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)      RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
            RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)              RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7)
                    RC(3,2) RC(3,3) RC(3,4) RC(3,5)              RC(3,11) RC(3,10) RC(3,9)
                                    RC(4,3) RC(4,4)
        >;
    };

    physical_layout_0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys
            = <&key_physical_attrs 100 100    0 135      0    0 135>
            , <&key_physical_attrs 100 100   95  60   -500   95  60>
            , <&key_physical_attrs 100 100  190 105   -400  190 105>
            , <&key_physical_attrs 100 100  285  10      0  285  10>
            , <&key_physical_attrs 100 100  380  75   -400  380  75>
            , <&key_physical_attrs 100 100  475  85   -400  475  85>
            , <&key_physical_attrs 100 100  740  85    400  740  85>
            , <&key_physical_attrs 100 100  835  75    400  835  75>
            , <&key_physical_attrs 100 100  930  10      0  930  10>
            , <&key_physical_attrs 100 100 1025  60    500 1025  60>
            , <&key_physical_attrs 100 100 1120 125    500 1120 125>
            , <&key_physical_attrs 100 100 1215 175      0 1215 175>
            , <&key_physical_attrs 100 100    0 240      0    0 240>
            , <&key_physical_attrs 100 100   95 170   -500   95 170>
            , <&key_physical_attrs 100 100  190 215   -400  190 215>
            , <&key_physical_attrs 100 100  285 120      0  285 120>
            , <&key_physical_attrs 100 100  380 185   -400  380 185>
            , <&key_physical_attrs 100 100  475 195   -400  475 195>
            , <&key_physical_attrs 100 100  740 195    400  740 195>
            , <&key_physical_attrs 100 100  835 185    400  835 185>
            , <&key_physical_attrs 100 100  930 120      0  930 120>
            , <&key_physical_attrs 100 100 1025 170    500 1025 170>
            , <&key_physical_attrs 100 100 1120 235    500 1120 235>
            , <&key_physical_attrs 100 100 1215 280      0 1215 280>
            , <&key_physical_attrs 100 100   95 290   -500   95 290>
            , <&key_physical_attrs 100 100  190 325   -400  190 325>
            , <&key_physical_attrs 100 100  285 235      0  285 235>
            , <&key_physical_attrs 100 100  380 295   -400  380 295>
            , <&key_physical_attrs 100 100  475 305   -400  475 305>
            , <&key_physical_attrs 100 100  835 295    400  835 295>
            , <&key_physical_attrs 100 100  930 235      0  930 235>
            , <&key_physical_attrs 100 100 1025 290    500 1025 290>
            , <&key_physical_attrs 100 100 1120 350    500 1120 350>
            , <&key_physical_attrs 100 100 1215 385      0 1215 385>
            , <&key_physical_attrs 100 100  190 430   -400  190 430>
            , <&key_physical_attrs 100 100  285 385      0  285 385>
            , <&key_physical_attrs 100 100  380 380    900  380 380>
            , <&key_physical_attrs 100 100  475 425   2300  475 425>
            , <&key_physical_attrs 100 100  740 425  -2300  740 425>
            , <&key_physical_attrs 100 100  835 380   -900  835 380>
            , <&key_physical_attrs 100 100  930 385      0  930 385>
            , <&key_physical_attrs 100 100  285 520   1800  285 520>
            , <&key_physical_attrs 100 100  380 570   3200  380 570>
            ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "row2col";
    };
};
