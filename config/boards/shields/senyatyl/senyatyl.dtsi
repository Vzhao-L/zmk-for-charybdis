#include <dt-bindings/zmk/matrix_transform.h>

#include <physical_layouts.dtsi>

&uicr {
    nfct-pins-as-gpios;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layouts = &physical_layout_0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)      RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)      RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
            RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)              RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7)
                    RC(3,2) RC(3,3) RC(3,4) RC(3,5)              RC(3,11) RC(3,10) RC(3,9)
                                    RC(4,3) RC(4,4)
        >;
    };

    physical_layout_0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys
            = <&key_physical_attrs 100 100    0 160 0    0 160>
            , <&key_physical_attrs 100 100  110 100 0  110 100>
            , <&key_physical_attrs 100 100  220  50 0  220  50>
            , <&key_physical_attrs 100 100  330   8 0  330   8>
            , <&key_physical_attrs 100 100  440  50 0  440  50>
            , <&key_physical_attrs 100 100  550  50 0  550  50>
            , <&key_physical_attrs 100 100  780  50 0  780  50>
            , <&key_physical_attrs 100 100  890  50 0  890  50>
            , <&key_physical_attrs 100 100 1000   0 0 1000   0>
            , <&key_physical_attrs 100 100 1110  50 0 1110  50>
            , <&key_physical_attrs 100 100 1220 100 0 1220 100>
            , <&key_physical_attrs 100 100 1330 160 0 1330 160>
            , <&key_physical_attrs 100 100    0 270 0    0 270>
            , <&key_physical_attrs 100 100  110 210 0  110 210>
            , <&key_physical_attrs 100 100  220 160 0  220 160>
            , <&key_physical_attrs 100 100  330 120 0  330 120>
            , <&key_physical_attrs 100 100  440 160 0  440 160>
            , <&key_physical_attrs 100 100  550 160 0  550 160>
            , <&key_physical_attrs 100 100  780 160 0  780 160>
            , <&key_physical_attrs 100 100  890 160 0  890 160>
            , <&key_physical_attrs 100 100 1000 110 0 1000 110>
            , <&key_physical_attrs 100 100 1110 160 0 1110 160>
            , <&key_physical_attrs 100 100 1220 210 0 1220 210>
            , <&key_physical_attrs 100 100 1330 270 0 1330 270>
            , <&key_physical_attrs 100 100  110 316 0  110 316>
            , <&key_physical_attrs 100 100  220 270 0  220 270>
            , <&key_physical_attrs 100 100  330 230 0  330 230>
            , <&key_physical_attrs 100 100  440 270 0  440 270>
            , <&key_physical_attrs 100 100  550 270 0  550 270>
            , <&key_physical_attrs 100 100  780 270 0  780 270>
            , <&key_physical_attrs 100 100  890 270 0  890 270>
            , <&key_physical_attrs 100 100 1000 220 0 1000 220>
            , <&key_physical_attrs 100 100 1110 270 0 1110 270>
            , <&key_physical_attrs 100 100 1220 320 0 1220 320>
            , <&key_physical_attrs 100 100  370 463 0  370 463>
            , <&key_physical_attrs 100 100  480 463 0  480 463>
            , <&key_physical_attrs 100 100  590 463 0  590 463>
            , <&key_physical_attrs 100 100  480 568 0  480 568>
            , <&key_physical_attrs 100 100  780 460 0  780 460>
            , <&key_physical_attrs 100 100  890 460 0  890 460>
            , <&key_physical_attrs 100 100  830 570 0  830 570>
            , <&key_physical_attrs 100 100  220 380 0  220 380>
            , <&key_physical_attrs 100 100  330 342 0  330 342>
            ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "row2col";
    };
};
