#include <dt-bindings/zmk/matrix_transform.h>

#include <physical_layouts.dtsi>

&uicr {
    nfct-pins-as-gpios;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layouts = &physical_layout_0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)      RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)      RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
            RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)              RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7)
                    RC(3,2) RC(3,3) RC(3,4) RC(3,5)              RC(3,11) RC(3,10) RC(3,9)
                                    RC(4,4) RC(4,5)
        >;
    };

    physical_layout_0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys
            = <&key_physical_attrs 100 100    0 152 0    0 152>
            , <&key_physical_attrs 100 100  105  95 0  105  95>
            , <&key_physical_attrs 100 100  209  48 0  209  48>
            , <&key_physical_attrs 100 100  314   8 0  314   8>
            , <&key_physical_attrs 100 100  418  48 0  418  48>
            , <&key_physical_attrs 100 100  522  48 0  522  48>
            , <&key_physical_attrs 100 100  741  48 0  741  48>
            , <&key_physical_attrs 100 100  846  48 0  846  48>
            , <&key_physical_attrs 100 100  950   0 0  950   0>
            , <&key_physical_attrs 100 100 1054  48 0 1054  48>
            , <&key_physical_attrs 100 100 1159  95 0 1159  95>
            , <&key_physical_attrs 100 100 1264 152 0 1264 152>
            , <&key_physical_attrs 100 100    0 257 0    0 257>
            , <&key_physical_attrs 100 100  105 200 0  105 200>
            , <&key_physical_attrs 100 100  209 152 0  209 152>
            , <&key_physical_attrs 100 100  314 114 0  314 114>
            , <&key_physical_attrs 100 100  418 152 0  418 152>
            , <&key_physical_attrs 100 100  522 152 0  522 152>
            , <&key_physical_attrs 100 100  741 152 0  741 152>
            , <&key_physical_attrs 100 100  846 152 0  846 152>
            , <&key_physical_attrs 100 100  950 105 0  950 105>
            , <&key_physical_attrs 100 100 1054 152 0 1054 152>
            , <&key_physical_attrs 100 100 1159 200 0 1159 200>
            , <&key_physical_attrs 100 100 1264 257 0 1264 257>
            , <&key_physical_attrs 100 100  105 300 0  105 300>
            , <&key_physical_attrs 100 100  209 257 0  209 257>
            , <&key_physical_attrs 100 100  314 218 0  314 218>
            , <&key_physical_attrs 100 100  418 257 0  418 257>
            , <&key_physical_attrs 100 100  522 257 0  522 257>
            , <&key_physical_attrs 100 100  741 257 0  741 257>
            , <&key_physical_attrs 100 100  846 257 0  846 257>
            , <&key_physical_attrs 100 100  950 209 0  950 209>
            , <&key_physical_attrs 100 100 1054 257 0 1054 257>
            , <&key_physical_attrs 100 100 1159 304 0 1159 304>
            , <&key_physical_attrs 100 100  352 440 0  352 440>
            , <&key_physical_attrs 100 100  456 440 0  456 440>
            , <&key_physical_attrs 100 100  561 440 0  561 440>
            , <&key_physical_attrs 100 100  456 540 0  456 540>
            , <&key_physical_attrs 100 100  741 437 0  741 437>
            , <&key_physical_attrs 100 100  846 437 0  846 437>
            , <&key_physical_attrs 100 100  789 542 0  789 542>
            , <&key_physical_attrs 100 100  209 361 0  209 361>
            , <&key_physical_attrs 100 100  314 325 0  314 325>
            ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "row2col";
    };
};
