#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
        smart_num_nav: smart_num_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&nav_word>, <&num_word>;

            display-name = "Smart Num/Nav";
        };

        nav_word: nav_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <LEFT DOWN UP RIGHT PG_DN PG_UP HOME END>;
            ignore-modifiers;
        };

        sym_word: sym_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <
                EXCL AT HASH DLLR PRCNT CARET AMPS ASTRK LPAR RPAR
                PLUS MINUS EQUAL UNDER
                LESS_THAN GREATER_THAN SEMICOLON COLON SLASH QMARK SQT DQT
                LEFT_BRACKET RIGHT_BRACKET LEFT_BRACE RIGHT_BRACE
                BACKSLASH PIPE GRAVE TILDE
            >;

            ignore-modifiers;
        };

        win_word: win_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <
                SEMICOLON LEFT_BRACKET RIGHT_BRACKET
                O M
                N1 N2 N3 N4 N5 N6 N7 N8 N9
                H J K L T
                Q P I
                X Y
                MINUS PLUS
            >;

            ignore-modifiers;
        };

        del_behavior: del_behavior {
            compatible = "zmk,behavior-mod-morph";
            label = "DEL_BEHAVIOR";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        dot_overwrite: dot_overwrite {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_OVERWRITE";
            bindings = <&kp PERIOD>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        smart_sym_alt: smart_sym_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp &sym_word>;
            display-name = "Smart Sym/Alt";
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 14 25>;
        };

        caps_word_combo {
            bindings = <&caps_word>;
            key-positions = <37 40>;
            layers = <0>;
        };

        lpkt {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 5>;
            layers = <0>;
        };

        lbrt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <17 16>;
            layers = <0>;
        };

        lbrs {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <29 28>;
            layers = <0>;
        };

        rpkt {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <6 7>;
            layers = <0>;
        };

        rbrt {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <19 18>;
            layers = <0>;
        };

        rbrs {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <30 31>;
            layers = <0>;
        };

        qw_esc {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
            layers = <0>;
        };

        sys_reset_left {
            bindings = <&sys_reset>;
            key-positions = <0 12>;
            layers = <7>;
        };

        bootloader_left {
            bindings = <&bootloader>;
            key-positions = <12 24>;
            layers = <7>;
        };

        sys_reset_right {
            bindings = <&sys_reset>;
            key-positions = <11 23>;
            layers = <7>;
        };

        bootloader_right {
            bindings = <&bootloader>;
            key-positions = <11 35>;
            layers = <7>;
        };

        bt_clear {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <4 3 2>;
            layers = <7>;
        };

        bt_clear_curr {
            bindings = <&bt BT_CLR>;
            key-positions = <14 15 16>;
            layers = <7>;
        };

        new_q {
            bindings = <&kp Q>;
            key-positions = <2 3>;
            layers = <0>;
        };

        new_z {
            bindings = <&kp Z>;
            key-positions = <3 4>;
            layers = <0>;
        };

        new_del {
            bindings = <&kp DEL>;
            key-positions = <2 3 4>;
            layers = <0>;
        };

        gth {
            bindings = <&gth>;
            key-positions = <4 16>;
            layers = <0>;
        };

        lthc {
            bindings = <&lth>;
            key-positions = <16 28>;
            layers = <0>;
        };

        h_tagc {
            bindings = <&h_tag>;
            key-positions = <7 19>;
        };

        arrowc {
            bindings = <&arrow>;
            key-positions = <8 20>;
        };

        to_win {
            bindings = <&win_word 4>;
            key-positions = <15 20>;
        };
    };

    macros {
        shrug: shrug {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_tap>,
                <&kp U>,
                <&macro_release>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_tap>,
                <&kp N0 &kp N0 &kp A &kp F &kp SPC>,
                <&macro_tap>,
                <&kp BACKSLASH>,
                <&macro_tap>,
                <&kp UNDER>,
                <&macro_tap>,
                <&kp LPAR>,
                <&macro_press>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_tap>,
                <&kp U>,
                <&macro_release>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_tap>,
                <&kp N3 &kp N0 &kp C &kp N4 &kp SPC>,
                <&macro_tap>,
                <&kp RPAR>,
                <&macro_tap>,
                <&kp UNDER>,
                <&macro_tap>,
                <&kp FSLH>,
                <&macro_press>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_tap>,
                <&kp U>,
                <&macro_release>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_tap>,
                <&kp N0 &kp N0 &kp A &kp F &kp SPC>;
        };

        gth: gth {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GT &kp EQUAL>;
            label = "GTH";
        };

        lth: lth {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp EQUAL>;
            label = "LTH";
        };

        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "ARROW";
        };

        h_tag: h_tag {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp POUND>;
            label = "H_TAG";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "QWERTY";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R               &kp T        &kp Y        &kp U                      &kp I      &kp O           &kp P     &del_behavior
&kp LSHFT  &kp A  &kp S  &kp D     &kp F               &kp G        &kp H        &kp J                      &kp K      &kp L           &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V               &kp B        &kp N        &kp M                      &kp COMMA  &dot_overwrite  &kp FSLH  &kp ESC
                         &kp LGUI  &smart_num_nav 2 5  &kp SPACE    &lt 3 ENTER  &smart_sym_alt LEFT_ALT 1
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };

        layer_1 {
            display-name = "SYMBOLS";
            bindings = <
&trans  &kp PLUS  &kp ASTRK  &kp TILDE  &none      &trans       &kp MINUS  &kp HASH   &kp AT    &kp CARET  &kp EQUAL       &trans
&trans  &kp PIPE  &kp LBRC   &kp RBRC   &kp GRAVE  &kp FSLH     &kp COLON  &kp QMARK  &kp LBKT  &kp RBKT   &kp DLLR        &trans
&trans  &kp DQT   &kp LT     &kp GT     &kp EXCL   &kp BSLH     &kp UNDER  &kp AMPS   &kp LPAR  &kp RPAR   &dot_overwrite  &trans
                             &trans     &trans     &kp SPACE    &kp ENTER  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };

        layer_2 {
            display-name = "NUMBERS";
            bindings = <
&trans  &trans   &trans  &kp J      &kp K   &kp PRCNT    &trans     &trans  &kp MINUS  &trans    &kp EQUAL  &kp BSPC
&trans  &kp N1   &kp N2  &kp N3     &kp N4  &trans       &trans     &kp N7  &kp N8     &kp N9    &kp N0     &trans
&trans  &kp DQT  &trans  &kp LS(G)  &kp N5  &kp V        &kp W      &kp N6  &kp LPAR   &kp RPAR  &trans     &trans
                         &trans     &trans  &kp SPACE    &kp ENTER  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };

        layer_3 {
            display-name = "FUNCTIONS";
            bindings = <
&trans  &trans      &trans      &trans  &trans  &trans    &kp C_PREVIOUS  &kp C_NEXT  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_MUTE  &kp C_PLAY_PAUSE
&trans  &kp F1      &kp F2      &kp F3  &kp F4  &kp F6    &trans          &kp F8      &kp F9             &kp F10          &kp F11     &kp F12
&trans  &bt BT_PRV  &bt BT_NXT  &trans  &kp F5  &trans    &trans          &kp F7      &trans             &trans           &trans      &trans
                                &trans  &trans  &trans    &mo 7           &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };

        layer_4 {
            display-name = "MANAGER";
            bindings = <
&trans  &trans                 &kp LA(SEMI)                       &mt LA(LS(LBKT)) LA(LBKT)  &mt LA(LS(RBKT)) LA(RBKT)  &trans                   &mt LA(LS(O)) LA(O)  &mt LA(LS(M)) LA(M)  &trans               &trans               &trans               &trans
&trans  &mt LA(LS(N1)) LA(N1)  &mt LA(LS(N2)) LA(N2)              &mt LA(LS(N3)) LA(N3)      &mt LA(LS(N4)) LA(N4)      &mt LS(LA(N9)) LA(N9)    &mt LS(LA(H)) LA(H)  &mt LA(LS(J)) LA(J)  &mt LA(LS(K)) LA(K)  &mt LA(LS(L)) LA(L)  &mt LA(LS(T)) LA(T)  &trans
&trans  &mt LA(LS(N5)) LA(N5)  &mt LA(LS(NUMBER_6)) LA(NUMBER_6)  &mt LA(LS(N7)) LA(N7)      &mt LA(LS(N8)) LA(N8)      &trans                   &mt LA(LS(R)) LA(Q)  &mt LA(MINUS) LA(X)  &mt LA(PLUS) LA(Y)   &mt LA(I) LA(P)      &trans               &trans
                                                                  &trans                     &mo 6                      &trans                   &trans               &trans
            >;
        };

        layer_5 {
            display-name = "NAV";
            bindings = <
&trans  &kp LC(D)             &kp LC(F)  &kp LC(C)        &kp LC(V)    &trans    &trans    &kp END    &kp HOME   &trans     &trans  &trans
&trans  &mt LEFT_SHIFT LC(A)  &mkp RCLK  &mkp MCLK        &mkp LCLK    &trans    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
&trans  &trans                &trans     &kp LC(LS(TAB))  &kp LC(TAB)  &trans    &trans    &kp PG_DN  &kp PG_UP  &trans     &trans  &trans
                                         &trans           &trans       &trans    &mo 4     &trans
            >;
        };

        layer_6 {
            display-name = "STACK";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans        &trans      &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LA(LEFT)  &kp LA(DOWN)  &kp LA(UP)  &kp LA(RIGHT)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans        &trans      &trans         &trans  &trans
                        &trans  &trans  &trans    &trans        &trans
            >;
        };

        layer_7 {
            display-name = "UTIL";
            bindings = <
&out OUT_TOG                      &bt BT_PRV       &bt BT_NXT       &none            &none            &none              &none         &none  &none         &none         &none         &none
&rgb_ug RGB_COLOR_HSB(256,64,46)  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF    &none         &none  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&rgb_ug RGB_COLOR_HSB(202,73,53)  &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD    &bt BT_SEL 0  &none  &none         &none         &none         &tog 7
                                                                    &none            &none            &none              &none         &none
            >;
        };

        layer_8 {
            display-name = "MOUSE";
            bindings = <
&trans  &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mkp MB4        &mkp RCLK       &mkp MCLK       &mkp LCLK        &mkp MB5     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &none           &none            &trans       &trans  &trans  &trans  &trans  &trans  &trans
                                        &mkp LCLK       &mkp MCLK        &mkp RCLK    &trans  &trans
            >;
        };
    };
};
