#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10


&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <160>;
    flavor = "tap-preferred";
    quick-tap-ms = <100>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
  // 上下滚动编码器行为
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    // 左右滚动编码器行为
    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <100>;
    };

behaviors {       
    };

   
   keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp GRAVE       &kp N1  &kp N2  &kp N3          &kp N4      &kp N5              &kp N6         &kp N7      &kp N8     &kp N9            &kp N0    &kp DEL
&kp TAB         &kp Q   &kp W   &kp F           &kp P       &kp B               &kp J          &kp L       &kp U      &kp Y             &kp SEMI  &kp BACKSPACE
&kp ESC         &mt LALT A &kp R   &kp S           &mt LSHFT T &kp G               &kp M          &mt RSHFT N &kp E      &kp I             &kp O     &kp SQT
&kp LCTRL       &kp Z   &kp X   &kp C           &kp D       &kp V               &kp K          &kp H       &kp COMMA  &kp PERIOD        &kp FSLH  &kp MINUS
                                &kp LWIN        &to 1       &mkp MB2            &kp LEFT_ALT   &kp SPACE
                                                &mkp MB1    &kp C_VOICE_COMMAND &kp ENTER
            >;
             sensor-bindings = <&scroll_vertical_encoder>,   // 编码器1：上下滚动
                             <&scroll_horizontal_encoder>;  // 编码器2：左右滚动

        };
// ... rest of layers remain same


        layer_1 {
            bindings = <
&bt BT_SEL 0    &kp F1           &kp F2           &kp F3           &kp F4           &kp F5                   &kp F6         &kp F7       &kp F8          &kp F9             &kp F10   &kp DEL 
&bt BT_SEL 1    &to 2            &kp N7           &kp N8           &kp N9           &none                    &bt BT_CLR     &kp EQUAL    &kp BSLH        &kp LBKT           &kp RBKT  &kp BACKSPACE
&bt BT_SEL 2    &kp N0           &kp N4           &kp N5           &kp N6           &none                    &none          &kp DOWN     &kp UP          &kp LEFT           &kp RIGHT &none
&bt BT_SEL 3    &none            &kp N1           &kp N2           &kp N3           &none                    &none          &none        &kp PERIOD      &kp RIGHT_BRACKET  &none     &kp EQUAL
                                                  &kp LWIN         &to 0            &mkp MB2                 &kp LEFT_ALT   &kp SPACE
                                                                   &mkp MB1         &kp C_VOICE_COMMAND      &kp ENTER
            >;

          
        };

        layer_2 {
            bindings = <
&kp GRAVE       &kp N1  &kp N2  &kp N3          &kp N4     &kp N5      &kp N6         &kp N7     &kp N8     &kp N9            &kp N0    &kp DEL
&kp TAB         &kp Q   &kp W   &kp E           &kp R      &mt LSHFT T &kp Y          &kp U      &kp I      &kp O             &kp P     &kp BACKSPACE
&kp ESC         &mt LALT A &kp S   &kp D           &kp F      &kp G       &kp H          &kp J      &kp K      &kp L             &kp SEMI  &kp SQT
&kp LCTRL       &kp Z   &kp X   &kp C           &kp V      &kp B       &mt RSHFT N    &kp M      &kp COMMA  &kp PERIOD        &kp FSLH  &kp MINUS
                                &kp LWIN &to 1      &mkp MB2    &kp LEFT_ALT   &kp SPACE
                                                &mkp MB1 &kp C_VOICE_COMMAND    &kp ENTER
            >;
             sensor-bindings = <&scroll_vertical_encoder>,
                             <&scroll_horizontal_encoder>;
        };

        /* Mouse {
            bindings = <
